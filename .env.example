# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). These two are safe to expose to the browser; RLS
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only credentials (never NEXT_PUBLIC_*). Not required by the app today;
# add here if you introduce server-side admin operations.
# SUPABASE_SERVICE_ROLE_KEY=
